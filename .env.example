# Variables mínimas necesarias
# Todas tienen valores por defecto, solo configura las que quieras personalizar

# Streaming mode (live-stream command)
# STREAMING_DEVICE: auto|cpu|cuda
STREAMING_MODEL_SIZE=medium
STREAMING_LANGUAGE=auto
STREAMING_DEVICE=auto
# STREAMING_BACKEND: mlx-whisper | faster-whisper | openai-whisper
STREAMING_BACKEND=mlx-whisper
# STREAMING_VAD_ENABLED: true = solo cuando detecta voz, false = transcribe todo el audio
STREAMING_VAD_ENABLED=true
# Formatos de exportación separados por comas (txt,json,srt,markdown)
STREAMING_EXPORT_FORMATS=txt,json
# true = mostrar métricas de captura y transcripción al finalizar
STREAMING_SHOW_METRICS=false
# true = generar resumen automático con LLM al finalizar
STREAMING_SUMMARIZE=false
# Modelo LLM para resumen (gemini o claude)
STREAMING_SUMMARY_MODEL=gemini
# (legacy) true = detección simple de cambios de speaker
STREAMING_SPEAKER_DETECTION=false
# none|simple|pyannote
STREAMING_SPEAKER_MODE=pyannote
# Umbral para detección de cambios de speaker (0.0-1.0)
SPEAKER_DETECTION_THRESHOLD=0.3
# true = enviar resumen por mensaje al finalizar
STREAMING_NOTIFY=false
# Plataforma de notificación (telegram)
STREAMING_NOTIFY_PLATFORM=telegram
# Token del bot de Telegram (requerido si STREAMING_NOTIFY=true)
TELEGRAM_BOT_TOKEN=
# ID del chat de Telegram (requerido si STREAMING_NOTIFY=true)
TELEGRAM_CHAT_ID=
# GitHub personal access token (requerido para create-issues)
GITHUB_TOKEN=
# API key para Google Gemini (requerido si STREAMING_SUMMARIZE=true y STREAMING_SUMMARY_MODEL=gemini)
GEMINI_API_KEY=
# API key para Anthropic Claude (requerido si STREAMING_SUMMARIZE=true y STREAMING_SUMMARY_MODEL=claude)
ANTHROPIC_API_KEY=
# Token HuggingFace (requerido para speaker diarization con pyannote)
HUGGINGFACE_TOKEN=

# Optional TOML config path (TOML overrides env)
# ESCRIBA_CONFIG=

# Pretend the running build is an older version for update-check soak tests (check-only)
# ESCRIBA_VERSION_OVERRIDE=1.3.0

# Watch-folder: max successfully processed paths to remember (FIFO eviction, default 10000)
# WATCH_PROCESSED_MAX=10000

# VAD (Voice Activity Detection) configuration
# Duración mínima de silencio en milisegundos
VAD_MIN_SILENCE_MS=500
# Umbral de sensibilidad (0.0-1.0), valores más bajos detectan más voz
VAD_THRESHOLD=0.3

# Whisper hallucination prevention (faster-whisper backend)
# These settings help prevent repetitive output like "los los los..." during silence
# false = prevents repetition loops (recommended)
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Filter silent segments (0.0-1.0, higher = more aggressive)
WHISPER_NO_SPEECH_THRESHOLD=0.6
# Filter repetitive patterns (lower = stricter)
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
# Filter low-confidence output (higher = stricter, max 0.0)
WHISPER_LOGPROB_THRESHOLD=-1.0

# Audio del sistema
# El sistema usa ScreenCaptureKit (API nativa de macOS) para capturar audio del sistema
# Solo necesitas permisos de Screen Recording en System Settings
# true = solo micrófono, false = sistema + micrófono
MIC_ONLY=false
# Factor de boost para el micrófono al mezclar (0.1-5.0, default: 1.4)
AUDIO_MIC_BOOST=1.4
